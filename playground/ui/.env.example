OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Agent Learning Playground
# Comma-separated single-use bootstrap codes (e.g. for the first admin); generate more in /admin
REGISTRATION_CODES=change-me-1,change-me-2
# Comma-separated usernames that can access /admin
ADMIN_USERNAMES=admin
# Optional: where users/sessions/progress are stored (default: ./.data)
# DATA_DIR=./.data
# Optional: max concurrent sandboxed test runs (default: 2)
# TEST_RUNNER_CONCURRENCY=2
