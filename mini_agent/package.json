{
	"name": "mini-agent",
	"private": true,
	"type": "module",
	"scripts": {
		"chat": "node --use-env-proxy --env-file=.env --experimental-strip-types test/chat.ts",
		"setup:mcp:github": "powershell -NoProfile -ExecutionPolicy Bypass -File mcp/install-github.ps1",
		"mcp:github": "node --env-file=.env --experimental-strip-types mcp/github.ts",
		"test:mcp:github": "node --env-file=.env --experimental-strip-types test/github/github-mcp.smoke.ts",
		"benchmark:github": "node --use-env-proxy --env-file=.env --experimental-strip-types test/github/github-token-benchmark.ts",
		"test:github:bash": "node --use-env-proxy --env-file=.env --experimental-strip-types test/github/bash-discovery.ts",
		"test": "node --experimental-strip-types --test test/agent.test.ts test/compaction.test.ts test/ddg_web_search.test.ts test/file.test.ts test/bash.test.ts test/mcp.test.ts test/github/github-mcp.test.ts test/skills.test.ts",
		"test:integration": "node --use-env-proxy --env-file=.env --experimental-strip-types --test test/agent.integration.test.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"yaml": "^2.8.1"
	}
}